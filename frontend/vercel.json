{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "YOUR_BACKEND_URL_HERE/api/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "YOUR_BACKEND_URL_HERE/storage/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
